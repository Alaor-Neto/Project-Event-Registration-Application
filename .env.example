# Copie este ficheiro para ".env" e substitua os valores abaixo.
# O ficheiro ".env" NÃO deve ser enviado para o GitHub (já está no .gitignore).
# Os valores "troca-..." abaixo são só exemplos: a aplicação recusa arrancar se os mantiver.
# Não use aspas nem espaços à volta do "=" (o Docker lê o ficheiro tal como está).

# Conta do organizador (única)
ORGANIZER_EMAIL=organizador@example.com
ORGANIZER_PASSWORD=mudar-esta-password

# Chave que assina as sessões (cookies de login).
# Gerar uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troca-por-uma-chave-aleatoria-longa

# Opcional (fora do Docker): onde guardar a base de dados SQLite.
# Por omissão usa ./data/registos.db. No Docker já é /data/registos.db, não alterar.
# DATABASE_PATH=data/registos.db

# Opcional: ligação a Postgres (ex.: Supabase). Se existir, a aplicação usa Postgres
# em vez de SQLite e passa a exigir SECRET_KEY.
# No Supabase: Connect > "Session pooler" (NÃO "Direct connection": só tem IPv6 e o Render não a alcança).
# Formato: postgresql://postgres.<ref-do-projeto>:<PASSWORD>@aws-1-<regiao>.pooler.supabase.com:5432/postgres
# <PASSWORD> substitui [YOUR-PASSWORD] por inteiro, SEM os parênteses [ ]. Use uma password só com letras e números.
# Esta URL é secreta: nunca vai para o GitHub (só para o painel do Render).
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
