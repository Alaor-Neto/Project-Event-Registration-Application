# Copie este ficheiro para ".env" e substitua os valores abaixo.
# O ficheiro ".env" NÃO deve ser enviado para o GitHub (já está no .gitignore).
# Os valores "troca-..." abaixo são só exemplos: a aplicação recusa arrancar se os mantiver.
# Não use aspas nem espaços à volta do "=" (o Docker lê o ficheiro tal como está).

# Conta do organizador (única)
ORGANIZER_EMAIL=admin@gmail.com
ORGANIZER_PASSWORD=admin123

# Chave que assina as sessões (cookies de login).
# Gerar uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troca-por-uma-chave-aleatoria-longa

# Opcional (fora do Docker): onde guardar a base de dados SQLite.
# Por omissão usa ./data/registos.db. No Docker já é /data/registos.db, não alterar.
# DATABASE_PATH=data/registos.db
