<%- include('partials/topo', { titulo: 'Organizador – Registos', coluna: 'col-12 col-lg-10 col-xl-9' }) %>
<div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-2">
  <div>
    <h2 class="h3">Registos</h2>
    <h3 class="fs-6 fw-normal text-secondary m-0"><%= evento.nome %></h3>
  </div>
  <form action="/organizador/sair" method="post">
    <button class="btn btn-outline-secondary" type="submit">Terminar sessão</button>
  </form>
</div>
<p class="fs-5">Total de registos: <span class="badge text-bg-primary" id="total"><%= total %></span></p>
<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead><tr><th>#</th><th>Nome</th><th>Email</th><th>Data de registo</th></tr></thead>
    <tbody>
      <% if (linhas.length === 0) { %>
      <tr><td colspan="4" class="text-center text-secondary">Ainda não há registos.</td></tr>
      <% } %>
      <% for (const r of linhas) { %>
      <tr><td><%= r.id %></td><td><%= r.nome %></td><td><%= r.email %></td><td><%= datahora(r.data_registo) %></td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('partials/fundo') %>
